<Project>
  <!-- Settings shared by every project in the repository. -->
  <PropertyGroup>
    <!-- Every project builds for .NET 10 (LTS) and .NET 11 (STS). CI builds and tests both. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Playbook.$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>Playbook.$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

  <!-- Guardrails. These apply to people and AI agents alike. Do not relax them to get a green build. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
</Project>
